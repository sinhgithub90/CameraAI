# Camera AI — template cấu hình.
# Copy sang .env rồi sửa:  cp .env.example .env   (Windows: copy .env.example .env)

# Model VLM trên Ollama — bạn bè dùng model Qwen khác thì đổi cái này
OLLAMA_MODEL=qwen3-vl:4b-instruct-q4_K_M

# Endpoint Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Qwen 4B trên GPU 6 GB: context 4096 giúp model nằm hoàn toàn trên GPU.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=160
OLLAMA_KEEP_ALIVE=10m

# Policy gọi VLM: gated (chỉ khi có trigger) | always (mọi input)
CAMERA_AI_VLM_POLICY=gated

# Nguồn VLM: ollama | mock (không cần Ollama, kết quả degraded)
CAMERA_AI_VLM=ollama
