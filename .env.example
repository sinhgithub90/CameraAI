# Camera AI — template cấu hình.
# Copy sang .env rồi sửa:  cp .env.example .env   (Windows: copy .env.example .env)

# Model VLM trên Ollama — bạn bè dùng model Qwen khác thì đổi cái này
OLLAMA_MODEL=qwen3-vl:2b-instruct-q8_0

# Endpoint Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Giữ model trong VRAM sau mỗi request (giây hoặc "30m"/"30m", "1h"...)
#  - 30m (mặc định): model tự unload sau 30 phút rảnh — phù hợp máy dùng chung GPU.
#  - -1: giữ mãi trong VRAM (~2.7GB cố định) — tránh reload + kernel-warmup
#    khi có khoảng nghỉ, nhưng chiếm VRAM; chỉ nên dùng nếu GPU riêng.
OLLAMA_KEEP_ALIVE=30m

# Context window Ollama dùng cho model (token). 12288 mặc định: đủ cho ~8 frame
# video @640px, giữ 100% GPU trên 3050 6GB. Tăng lên thì tốn KV cache VRAM;
# quá cao (>= 16384) sẽ tràn xuống CPU và làm chậm sinh token.
OLLAMA_NUM_CTX=12288

# Policy gọi VLM: gated (chỉ khi có trigger) | always (mọi input)
CAMERA_AI_VLM_POLICY=gated

# Nguồn VLM: ollama | mock (không cần Ollama, kết quả degraded)
CAMERA_AI_VLM=ollama

# Tầng fire/smoke.
#  - Bỏ comment dòng dưới để dùng model fire YOLO nhẹ (tự tải lần đầu):
# FIRE_MODEL=https://huggingface.co/LK-ROBOTICS/nxp-sf-yolo11n-balanced/resolve/main/revisions/v1/best.pt
#  - Đặt FIRE_MODEL=none để tắt hẳn tầng fire.
#  - Không set gì: dùng model fire mặc định (như URL trên).
